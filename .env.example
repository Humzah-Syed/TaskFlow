# copy to .env and tweak — dont commit real secrets
APP_NAME=TaskFlow
API_PREFIX=/api/v1
ENVIRONMENT=development

POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_HOST=localhost
# docker compose in this repo maps host 5433 -> container 5432 so you dont step on a normal local postgres
POSTGRES_PORT=5433
POSTGRES_DB=taskflow

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_BASE_SECONDS=2
